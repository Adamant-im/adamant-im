{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vite-config/**/*.ts",
    "vite-base.config.ts",
    "vite-pwa.config.ts",
    "vitest.config.ts",
    "electron-vite.config.ts",
    "src/lib/urlFormatter.ts"
  ]
}
